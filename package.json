{
	"name": "oren-plant-data",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "node scripts/ensure-prisma-client.mjs && next dev",
		"build": "node scripts/ensure-prisma-client.mjs && next build",
		"start": "next start",
		"typecheck": "node scripts/ensure-prisma-client.mjs && tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:push": "prisma db push",
		"db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
		"db:studio": "prisma studio",
		"db:reset-demo": "tsx --env-file-if-exists=.env scripts/reset-demo.ts",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@hookform/resolvers": "^3.3.4",
		"@prisma/client": "6.10.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tanstack/react-query": "^4.36.1",
		"@trpc/client": "^10.45.2",
		"@trpc/next": "^10.45.2",
		"@trpc/react-query": "^10.45.2",
		"@trpc/server": "^10.45.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"next": "^14.2.35",
		"postcss": "^8.5.6",
		"radix-ui": "^1.4.3",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-hook-form": "^7.51.3",
		"react-hot-toast": "^2.4.1",
		"superjson": "^2.2.1",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "1.48.2",
		"@types/node": "^22.10.0",
		"@types/react": "^18.2.79",
		"@types/react-dom": "^18.2.25",
		"prisma": "6.10.1",
		"tsx": "^4.19.2",
		"typescript": "^5.3.3",
		"vite": "^7.1.0",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"vite": "$vite"
	}
}
